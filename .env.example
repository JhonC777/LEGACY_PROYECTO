# Supabase (clave publicable, va al navegador). Nunca pongas service_role aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (DSN publicable del navegador). Vacío = el SDK no se inicia.
# El valor real está en Vercel (Production y Preview). No lo pegues aquí.
VITE_SENTRY_DSN=

# Solo en el build de Vercel. Sin prefijo VITE_: no llega al navegador.
# Si falta, el build sigue y no genera ni sube source maps.
# SENTRY_AUTH_TOKEN=

# Servidor únicamente. Nunca uses el prefijo VITE_ en claves secretas (se filtrarían al navegador).

# IA gratis (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Opcional / pago. Ya no se usa si Gemini está configurado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
